# Banco da aplicação (dentro do compose o host é "postgres"; fora, "localhost")
DATABASE_URL=postgresql+psycopg://giro:giro@postgres:5432/giro
POSTGRES_USER=giro
POSTGRES_PASSWORD=giro

# Token compartilhado entre n8n e API (header X-Service-Token). Troque em produção.
SERVICE_TOKEN=troque-este-token

N8N_WEBHOOK_URL=http://n8n:5678/webhook
APP_BASE_URL=http://localhost:8000

STORE_NAME=Mercearia Demo
STORE_TZ=America/Sao_Paulo
OWNER_WHATSAPP=+5511900000000

# WhatsApp Cloud API (Meta). Enquanto true, nada é enviado: o pedido é marcado como "simulado".
WHATSAPP_DRY_RUN=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# Popular o banco com a mercearia fictícia na primeira subida
SEED_DEMO=true
