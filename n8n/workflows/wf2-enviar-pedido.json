{
  "id": "giroWf2EnviarPed",
  "name": "Giro · WF2 Enviar pedido ao fornecedor",
  "active": false,
  "versionId": "6f1d2c3a-2b7e-4d1a-9a55-2f0e7c1b0002",
  "settings": { "executionOrder": "v1", "timezone": "America/Sao_Paulo" },
  "nodes": [
    {
      "id": "a2f0b1c0-0000-4000-8000-000000000001",
      "name": "Pedido aprovado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "5c8d7e4f-1a2b-4c3d-8e9f-0a1b2c3d4e5f",
      "parameters": {
        "httpMethod": "POST",
        "path": "pedido-aprovado",
        "responseMode": "onReceived",
        "options": { "responseCode": 202 }
      }
    },
    {
      "id": "a2f0b1c0-0000-4000-8000-000000000002",
      "name": "Reservar envio (claim)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/api/purchase-orders/{{ $json.body.order_id }}/claim",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Service-Token", "value": "={{ $env.SERVICE_TOKEN }}" }]
        },
        "options": {}
      }
    },
    {
      "id": "a2f0b1c0-0000-4000-8000-000000000003",
      "name": "Dry-run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, -100],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $env.WHATSAPP_DRY_RUN }}",
              "rightValue": "false",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a2f0b1c0-0000-4000-8000-000000000004",
      "name": "Registrar envio simulado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -200],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/api/purchase-orders/{{ $('Reservar envio (claim)').item.json.id }}/sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Service-Token", "value": "={{ $env.SERVICE_TOKEN }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message_text: $('Reservar envio (claim)').item.json.message_preview, dry_run: true }) }}",
        "options": {}
      }
    },
    {
      "id": "a2f0b1c0-0000-4000-8000-000000000005",
      "name": "WhatsApp: pedido_compra",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.WHATSAPP_GRAPH_VERSION }}/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $('Reservar envio (claim)').item.json.supplier.whatsapp_digits, type: 'template', template: { name: 'pedido_compra', language: { code: 'pt_BR' }, components: [{ type: 'body', parameters: $('Reservar envio (claim)').item.json.template_params.map(text => ({ type: 'text', text })) }] } }) }}",
        "options": {}
      }
    },
    {
      "id": "a2f0b1c0-0000-4000-8000-000000000006",
      "name": "Registrar envio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, -60],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/api/purchase-orders/{{ $('Reservar envio (claim)').item.json.id }}/sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Service-Token", "value": "={{ $env.SERVICE_TOKEN }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message_text: $('Reservar envio (claim)').item.json.message_preview, dry_run: false, whatsapp_message_id: $json.messages?.[0]?.id ?? null }) }}",
        "options": {}
      }
    },
    {
      "id": "a2f0b1c0-0000-4000-8000-000000000007",
      "name": "Registrar falha",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 120],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/api/purchase-orders/{{ $('Reservar envio (claim)').item.json.id }}/failed",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Service-Token", "value": "={{ $env.SERVICE_TOKEN }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ error: String([$json.error?.message, $json.error?.description].filter(Boolean).join(' — ') || 'falha desconhecida no envio').slice(0, 1900) }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Pedido aprovado": {
      "main": [[{ "node": "Reservar envio (claim)", "type": "main", "index": 0 }]]
    },
    "Reservar envio (claim)": {
      "main": [[{ "node": "Dry-run?", "type": "main", "index": 0 }], []]
    },
    "Dry-run?": {
      "main": [
        [{ "node": "Registrar envio simulado", "type": "main", "index": 0 }],
        [{ "node": "WhatsApp: pedido_compra", "type": "main", "index": 0 }]
      ]
    },
    "WhatsApp: pedido_compra": {
      "main": [
        [{ "node": "Registrar envio", "type": "main", "index": 0 }],
        [{ "node": "Registrar falha", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {}
}
