            "index": 0
          }
        ]
      ]
    },
    "Tem pedido?": {
      "main": [
        [
          {
            "node": "Disparar WF2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Executar sob demanda": {
      "main": [
        [
          {
            "node": "Sugerir pedidos",
            "type": "main",
            "index": 0
          },
          {
            "node": "Aprovados sem envio",
            "type": "main",
